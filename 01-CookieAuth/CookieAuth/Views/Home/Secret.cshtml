<h1>Secret</h1>

@* User is the ClaimsPrincipal rebuilt from the cookie on every request.
   Controllers have the same User property. *@

<p>Hello, @User.Identity!.Name</p>

<p>Reading claims directly:</p>
<ul>
    <li><code>User.FindFirstValue(ClaimTypes.Name)</code> = @User.FindFirstValue(ClaimTypes.Name)</li>
    <li><code>User.HasClaim("IsAdmin", "true")</code> = @User.HasClaim("IsAdmin", "true")</li>
</ul>

<p>All claims in the cookie:</p>
<table border="1">
    @foreach (var claim in User.Claims)
    {
        <tr>
            <td>@claim.Type</td>
            <td>@claim.Value</td>
        </tr>
    }
</table>
