<h1>Register</h1>

<form method="post">
    <input name="email" type="email" placeholder="Email" />
    <input name="password" type="password" placeholder="Password" />
    <button type="submit">Register</button>
</form>

@if (ViewBag.Errors != null)
{
    <ul style="color: red">
        @foreach (string error in ViewBag.Errors)
        {
            <li>@error</li>
        }
    </ul>
}
