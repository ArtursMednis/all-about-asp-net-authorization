{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    // Who created the token (this API).
    "Issuer": "TokenAuthApi",
    // Who the token is meant for (also this API).
    "Audience": "TokenAuthApi",
    // Signs the tokens. At least 32 characters for HS256.
    // Demo only: in a real app keep it out of source control (user secrets, environment variable, key vault).
    "Key": "demo-signing-key-that-is-at-least-32-characters-long",
    "DurationInMinutes": 5
  }
}
