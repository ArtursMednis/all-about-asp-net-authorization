@using Microsoft.AspNetCore.Identity
@{
    IList<UserLoginInfo> logins = ViewBag.Logins;
}

<h1>Secret</h1>

<p>Hello, @User.Identity!.Name</p>

<p>How this account can log in:</p>
<ul>
    <li>Password: @(ViewBag.HasPassword ? "yes" : "no")</li>
    @foreach (var login in logins)
    {
        <li>@login.ProviderDisplayName (Google user id @login.ProviderKey)</li>
    }
</ul>

<p>
    The claims below are <b>our</b> user's claims, from our database - not Google's.
    Google only told us who you are; from then on it's a normal Identity login.
</p>
<table border="1">
    @foreach (var claim in User.Claims)
    {
        <tr>
            <td>@claim.Type</td>
            <td>@claim.Value</td>
        </tr>
    }
</table>
