@using System.Buffers.Text
@using System.Text
@{
    string? Payload(string? jwt)
    {
        // A JWT is header.payload.signature - the payload is base64url-encoded JSON.
        var parts = jwt?.Split('.');
        return parts?.Length == 3 ? Encoding.UTF8.GetString(Base64Url.DecodeFromChars(parts[1])) : null;
    }

    string? idToken = ViewBag.IdToken;
    string? accessToken = ViewBag.AccessToken;
}

<h1>Secret</h1>

<p>Hello, @User.Identity!.Name</p>

<p>Claims in this app's cookie (from the ID token and the userinfo endpoint):</p>
<table border="1">
    @foreach (var claim in User.Claims)
    {
        <tr>
            <td>@claim.Type</td>
            <td>@claim.Value</td>
        </tr>
    }
</table>

<h2>ID token</h2>
<p>Tells this app <b>who</b> logged in. Meant for us, so we can read it:</p>
<pre>@Payload(idToken)</pre>

<h2>Access token</h2>
<p>
    Lets this app call APIs (here only the userinfo endpoint) on the user's behalf.
    It's meant for the API, not for us - we just pass it along.
    @if (Payload(accessToken) == null)
    {
        <text>This one is encrypted, so we can't even read it.</text>
    }
</p>
<pre>@(Payload(accessToken) ?? accessToken?[..80] + "...")</pre>
