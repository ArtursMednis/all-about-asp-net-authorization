@model ExtendingIdentityUser.Data.AppUser

<h1>Secret</h1>

<p>Hello, @Model.DisplayName</p>

<p>
    <code>DisplayName</code> came from the database. It is <b>not</b> one of the claims below,
    because Identity only puts standard fields and the user's claims into the cookie.
</p>

<p>Claims in the cookie:</p>
<table border="1">
    @foreach (var claim in User.Claims)
    {
        <tr>
            <td>@claim.Type</td>
            <td>@claim.Value</td>
        </tr>
    }
</table>
