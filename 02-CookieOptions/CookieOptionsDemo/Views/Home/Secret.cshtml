@model Microsoft.AspNetCore.Authentication.AuthenticationProperties

<h1>Secret</h1>

<p>Hello, @User.Identity!.Name</p>

<p>Cookie properties:</p>
<ul>
    <li>Issued: @Model.IssuedUtc?.ToLocalTime()</li>
    <li>Expires: @Model.ExpiresUtc?.ToLocalTime()</li>
    <li>Persistent (remember me): @Model.IsPersistent</li>
    <li>Now: @DateTimeOffset.Now</li>
</ul>

<p>
    Reload this page after ~30 seconds: sliding expiration issues a new cookie and the next reload
    shows new dates. Wait more than a minute without reloading and you're logged out.
</p>

<p>Claims in the cookie:</p>
<table border="1">
    @foreach (var claim in User.Claims)
    {
        <tr>
            <td>@claim.Type</td>
            <td>@claim.Value</td>
        </tr>
    }
</table>
