<h1>Secret</h1>

<p>Hello, @User.Identity!.Name</p>

<p>
    Your session at the auth server: <b>@User.FindFirstValue("sid")</b>.
    When that session ends, the auth server tells this app, and this page stops working.
</p>

<table border="1">
    @foreach (var claim in User.Claims)
    {
        <tr>
            <td>@claim.Type</td>
            <td>@claim.Value</td>
        </tr>
    }
</table>
