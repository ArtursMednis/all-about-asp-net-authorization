<h1>Secret</h1>

<p>Hello, @User.Identity!.Name. This action has no attribute - the fallback policy still required a login.</p>

<ul>
    <li><code>User.IsInRole("Admin")</code> = @User.IsInRole("Admin")</li>
    <li><code>User.IsInRole("Employee")</code> = @User.IsInRole("Employee")</li>
</ul>

<p>Roles are ordinary claims of type <code>role</code>:</p>
<table border="1">
    @foreach (var claim in User.Claims)
    {
        <tr>
            <td>@claim.Type</td>
            <td>@claim.Value</td>
        </tr>
    }
</table>
